.DS_Store
DerivedData/
*.xcuserstate
build

# Vendor/ holds engines + models bundled into the app. Only the scripts and
# small config files are tracked; binaries, weights and venvs are regenerated
# locally (see docs/PROJECT.md §9.2). Directory-level re-includes are needed
# because git never descends into an ignored directory.
raw_models/
Vendor/*
!Vendor/trocr/
Vendor/trocr/*
!Vendor/trocr/convert.py
!Vendor/trocr/export_tokenizer.py
__pycache__/

.devswarm-temp/
.trocr-venv/
dist/
